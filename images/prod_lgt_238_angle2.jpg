    if (window.__youm7GA4Init) return;
    window.__youm7GA4Init = true;

    window.dataLayer = window.dataLayer || [];

    window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
    };

    gtag("js", new Date());

    gtag("config", GA_ID, {
        send_page_view: false
    });

    // One ID per initial page load
    var pvEventId = createId();

    function createId() {
        if (window.crypto &&
            typeof window.crypto.randomUUID === "function") {
            return window.crypto.randomUUID();
        }

        return String(Date.now()) + "-" +
               Math.random().toString(36).slice(2);
    }

    function firePV(source, newView) {
        try {
            // BFCache restoration is a new view
            if (newView) {
                pvEventId = createId();
            }

            gtag("event", "page_view", {
                send_to: GA_ID,
                event_id: pvEventId,
                pv_src: source,
                page_location: window.location.href,
                page_title: document.title
            });

        } catch (e) {
            // Keep page functioning if tracking fails
        }
    }

    // 1. Original initial page_view
    firePV("load", false);

    // 2. Original interaction fallback
    (function () {
        var retried = false;

        function retryOnce() {
            if (retried) return;
            retried = true;

            // Original behavior preserved
            firePV("retry", false);

            window.removeEventListener(
                "pointerdown", retryOnce, true
            );
            window.removeEventListener(
                "touchstart", retryOnce, true
            );
            window.removeEventListener(
                "keydown", retryOnce, true
            );
            window.removeEventListener(
                "scroll", retryOnce, true
            );
        }

        window.addEventListener(
            "pointerdown", retryOnce, true
        );
        window.addEventListener(
            "touchstart", retryOnce, true
        );
        window.addEventListener(
            "keydown", retryOnce, true
        );
        window.addEventListener(
            "scroll", retryOnce, true
        );
    })();

    // 3. NEW: Safari / Chrome BFCache
    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            firePV("bfcache_restore", true);
        }
    });

    // 4. NEW: Detect library load failure
    var originalScript =
        document.getElementById("youm7-ga4-script");

    var libraryLoaded = false;
    var originalFailed = false;
    var retryStarted = false;
    var retryLoading = false;

    function retryLibrary() {
        if (libraryLoaded ||
            retryStarted ||
            retryLoading ||
            !originalFailed ||
            navigator.onLine === false) {
            return;
        }

        retryStarted = true;
        retryLoading = true;

        var script = document.createElement("script");
        script.async = true;
        script.setAttribute("data-cfasync", "false");

        script.onload = function () {
            libraryLoaded = true;
            retryLoading = false;
        };

        script.onerror = function () {
            retryLoading = false;
            script.remove();
        };

        script.src = GA_URL;
        document.head.appendChild(script);
    }

    if (originalScript) {
        originalScript.addEventListener("load", function () {
            libraryLoaded = true;
        });

        originalScript.addEventListener("error", function () {
            originalFailed = true;

            if (navigator.onLine !== false) {
                setTimeout(retryLibrary, 2000);
            }
        });
    }

    // 5. NEW: Recover when connection returns
    window.addEventListener("online", function () {
        if (originalFailed && !libraryLoaded) {
            retryLibrary();
        }
    });

})();
